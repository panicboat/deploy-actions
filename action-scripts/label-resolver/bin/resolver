#!/usr/bin/env ruby

# CLI interface for label resolver functionality

require_relative '../application'
require 'thor'

class LabelResolverCLI < Thor
  # Thor exits 0 on a missing PR number unless this is true.
  def self.exit_on_failure?
    true
  end

  desc "resolve PR_NUMBER [ENVIRONMENTS]", "Resolve deployment matrix for specified environments (comma-separated, empty=all)"

  def resolve(pr_number, environments = nil)
    controller = LabelResolverContainer.resolve(:label_resolver_controller)

    result = controller.resolve(pr_number: pr_number.to_i, environments: parse_environments(environments))
    exit 1 if result.failure?
  end

  desc "targets SERVICE [ENVIRONMENTS]", "Resolve the targets of one service without a pull request (comma-separated environments, empty=all)"

  def targets(service, environments = nil)
    controller = LabelResolverContainer.resolve(:label_resolver_controller)

    result = controller.targets(service: service, environments: parse_environments(environments))
    exit 1 if result.failure?
  end

  private

  def parse_environments(env_string)
    return [] if env_string.nil? || env_string.strip.empty?
    env_string.split(',').map(&:strip)
  end
end

LabelResolverCLI.start(ARGV) if $PROGRAM_NAME == __FILE__
