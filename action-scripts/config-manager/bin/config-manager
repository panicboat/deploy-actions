#!/usr/bin/env ruby

# CLI interface for configuration management functionality

require_relative '../application'
require 'thor'

class ConfigManagerCLI < Thor
  # Thor exits 0 on a missing service name unless this is true.
  def self.exit_on_failure?
    true
  end

  desc "validate", "Validate workflow configuration file"

  def validate
    controller = ConfigManagerContainer.resolve(:config_manager_controller)
    result = controller.validate
    exit 1 if result.failure?
  end

  desc "test SERVICE [ENVIRONMENT]", "Show the targets of a service and whether each is excluded"

  def test(service_name, environment = nil)
    controller = ConfigManagerContainer.resolve(:config_manager_controller)
    result = controller.test_service(service_name: service_name, environment: environment)
    exit 1 if result.failure?
  end
end

ConfigManagerCLI.start(ARGV) if $PROGRAM_NAME == __FILE__
