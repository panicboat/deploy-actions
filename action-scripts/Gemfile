source 'https://rubygems.org'

# Core dependencies
gem 'thor', '~> 1.5'           # CLI framework

# External APIs & Services
gem 'octokit', '~> 10.0'       # GitHub API client

# Configuration & Data
gem 'yaml', '~> 0.4'           # YAML parsing
gem 'json', '~> 3.1'          # JSON handling

# Utilities
gem 'colorize', '~> 1.1'       # Colored terminal output
gem "faraday-retry", "~> 2.4"  # Faraday middleware for retries

# Development dependencies
group :development do
  gem 'rubocop', '~> 1.92', '>= 1.92.1'          # Code style checker
  gem 'rubocop-rspec', '~> 3.10', '>= 3.10.2'     # RSpec style checker
  gem 'pry', '~> 0.16', '>= 0.16.1'               # Debugging
end

# Test dependencies
group :test do
  gem 'rspec', '~> 3.13', '>= 3.13.2'            # Testing framework
  gem 'webmock', '~> 3.34'          # HTTP request stubbing
  gem 'vcr', '~> 6.4', '>= 6.4.1'               # HTTP interaction recording
  gem 'factory_bot', '~> 6.6'       # Test data factories
end
